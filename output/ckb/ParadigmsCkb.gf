 reg2A : Str -> Str -> A   -- lemma  ezafe;nocomparison;nospecies;sg
    = \form1, form2 -> case <form1, form2> of {
		<_ + "ane", _ + "y"> => mkA005 form1;
		<_ + "dar", _ + "î"> => mkA004 form1;
		<_ + "wan", _ + "î"> => mkA004 form1;
		<_ + "ştî", _ + "y"> => mkA005 form1;
